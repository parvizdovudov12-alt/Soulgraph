modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33533
externalPort = 3002

[[ports]]
localPort = 34067
externalPort = 3001

[[ports]]
localPort = 35269
externalPort = 4200

[[ports]]
localPort = 36359
externalPort = 5173

[[ports]]
localPort = 36553
externalPort = 3000

[[ports]]
localPort = 40133
externalPort = 5000

[[ports]]
localPort = 40687
externalPort = 6800

[[ports]]
localPort = 41871
externalPort = 3003

[[ports]]
localPort = 42413
externalPort = 8000

[[ports]]
localPort = 44119
externalPort = 9000

[[ports]]
localPort = 45747
externalPort = 6000

[[ports]]
localPort = 46025
externalPort = 8080

[[ports]]
localPort = 46063
externalPort = 8081

[[ports]]
localPort = 46801
externalPort = 8008

[[ports]]
localPort = 46811
externalPort = 8099

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
